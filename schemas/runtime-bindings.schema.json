{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime operational SQL tag bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicateId",
    "mappingRevision",
    "replacements"
  ],
  "properties": {
    "predicateId": {
      "type": "string"
    },
    "mappingRevision": {
      "const": 6
    },
    "replacements": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "bindValues": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  }
}
